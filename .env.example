# Supabase (required for auth and database)
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Guest listing checkout uses Supabase Anonymous Sign-Ins (Authentication → Providers → Anonymous).
# Optional: for Stripe webhook (create purchase / mark sold). Dashboard > Developers > Webhooks
SUPABASE_SERVICE_ROLE_KEY=

# Resend — custom SMTP for Supabase Auth emails (reset password, confirm signup, magic link, etc.).
# The Next.js app does not send these; Supabase Auth does. After setting RESEND_API_KEY here, paste the
# same value into Supabase Dashboard → Project Settings → Authentication → SMTP Settings → Password.
# Resend SMTP: host smtp.resend.com · port 465 · user resend · sender noreply@reswell.app · name Reswell
# Verify reswell.app in Resend and add DNS (SPF/DKIM) before going live. https://resend.com/docs/send-with-smtp
RESEND_API_KEY=
# Optional — default From if you automate Supabase SMTP setup (Management API / scripts).
# RESEND_AUTH_FROM_EMAIL=noreply@reswell.app

# In-app Messages: “Ask someone now” opens a DM with a Reswell teammate. Prefer UUID (MESSAGES_DIRECT_SUPPORT_USER_ID).
# Email is resolved via public.profiles with the service-role client (must match Auth email on that profile).
# MESSAGES_DIRECT_SUPPORT_USER_ID=
MESSAGES_DIRECT_SUPPORT_EMAIL=haydensbsb@gmail.com

# Cloudflare: this app talks to Supabase over HTTPS (PostgREST) via supabase-js — not raw Postgres.
# On Cloudflare Pages, set the same NEXT_PUBLIC_SUPABASE_* (and server-only keys) in the project Environment variables.
# Cloudflare D1 is SQLite (separate product); it does not “host” your Supabase data unless you build a sync yourself.
# For Cloudflare Workers that run SQL with node-postgres/pg, use Hyperdrive → Supabase Postgres (direct connection string):
# https://developers.cloudflare.com/hyperdrive/examples/connect-to-postgres/supabase/

# Stripe — required for card checkout + Connect (bank cash-out). Test: sk_test_... / pk_test_...
# Bank cash-out moves settled funds from this platform account’s Stripe balance to each seller’s Connect account;
# the Dashboard Balance “available” amount must cover the transfer (wallet balance in the app is a separate ledger).
STRIPE_SECRET_KEY=
# Optional: dedicated HMAC secret for signed checkout shipping-quote tokens (falls back to STRIPE_SECRET_KEY).
# CHECKOUT_QUOTE_SIGNING_SECRET=
# Optional: only if your secret key is from a parent org (not the Connect platform account).
# V2 Connect then needs Stripe-Context = this_platform_acct / connected_acct
# STRIPE_PLATFORM_ACCOUNT_ID=acct_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret (whsec_...) from Stripe CLI or Dashboard. Use the secret for THIS endpoint URL;
# CLI `stripe listen` secrets cannot verify Dashboard deliveries. Multiple secrets during rotation: comma or newline-separated.
# Local Connect V2 thin events + Checkout: npm run stripe:listen
# Peer card checkout + Connect cash-out: Stripe Dashboard → Webhooks → URL …/api/webhooks/stripe
# Events: payment_intent.succeeded, refund.created, refund.updated, account.updated, transfer.reversed
STRIPE_WEBHOOK_SECRET=

# Stripe Terminal — in-person tap-to-pay for admin listing checkout (Stripe Terminal S710 / WisePOS E).
# Create a Terminal location in Stripe Dashboard → Terminal → Locations, register your reader to it,
# then set the location ID here (tml_…). Admins use /admin/orders/terminal.
# STRIPE_TERMINAL_LOCATION_ID=

# Base URL for Connect return/refresh links and checkout (e.g. http://localhost:3000 locally, https://www.reswell.app in production)
NEXT_PUBLIC_URL=

# App URL for Stripe redirects and canonical metadata (see lib/public-site-origin.ts). Production: https://www.reswell.app
# (www is the Vercel canonical host — apex 308s to www, so apex URLs add a redirect hop mid-OAuth).
# Google OAuth callback uses the browser’s origin (see lib/auth/oauth-callback-url.ts). In Supabase → Authentication →
# URL Configuration → Site URL = https://www.reswell.app; Redirect URLs: add every origin you use,
# e.g. http://localhost:3000/auth/callback and https://www.reswell.app/auth/callback.
# Forgot-password uses `/auth/recovery`, then redirects to `/auth/update-password`. Allowlist `/auth/recovery` and `/auth/callback` per origin.
NEXT_PUBLIC_APP_URL=

# Optional: same as NEXT_PUBLIC_APP_URL for some deploys; publicSiteOrigin() prefers SITE_URL then APP_URL.
# Unfurlers (iMessage, Slack) cannot load og:image from localhost — use a public URL (deploy preview sets VERCEL_URL).
# Used only for metadata / sitemap / OG URLs. Host canonicalization (HTTPS upgrade + www↔apex)
# is owned by Vercel's Project → Domains "Primary Domain" — never re-implement it in proxy.ts
# (proxy + Vercel both redirecting causes ERR_TOO_MANY_REDIRECTS).
# NEXT_PUBLIC_SITE_URL=https://www.reswell.app

# Google Ads — optional; global site tag (gtag.js) for conversion measurement. Set to your AW-* ID from Google Ads.
# https://support.google.com/google-ads/answer/7548399
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18062254229
# Sign-up conversion action send_to (Google Ads → Goals → Conversions → tag setup), e.g. AW-1234567890/AbCdEfGh
NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_CONVERSION=
# Or use a page-load conversion in Google Ads for: /auth/google-sign-up-success
# Purchase conversion — fires on /successpage/[orderId] with transaction_id + order total.
# Option A: full send_to string:
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_CONVERSION=AW-18062254229/FsjrCPnlwbAcEJXB4KRD
# Option B: label only (uses NEXT_PUBLIC_GOOGLE_ADS_ID above):
# NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_CONVERSION_LABEL=FsjrCPnlwbAcEJXB4KRD

# Google Merchant API — optional; sync active surfboard listings to Merchant Center for Shopping / PMax ads.
# Auth (production): Workload Identity Federation via Vercel OIDC — no service account keys in env.
#   1. Vercel project → Settings → Secure backend access → enable OIDC
#   2. GCP → IAM → Workload Identity Federation → pool + OIDC provider (issuer https://oidc.vercel.com/[TEAM_SLUG])
#   3. GCP service account + grant pool principal access (see https://vercel.com/docs/oidc/gcp)
#   4. Add that service account as a user in Merchant Center (Standard+)
#   5. One-time developerRegistration + API data source (POST /api/integrations/google-merchant/setup)
# Auth (local dev fallback): GOOGLE_MERCHANT_SERVICE_ACCOUNT_JSON or GOOGLE_APPLICATION_CREDENTIALS
# Debug: GET /api/integrations/google-merchant/status
# Bulk sync: POST /api/integrations/google-merchant/sync (admin session or Bearer SEARCH_REINDEX_SECRET)
# Real-time: Supabase Database Webhook on `listings` → POST /api/integrations/google-merchant/webhook
# Hourly refresh + orphan reconciliation: GET /api/cron/google-merchant-refresh (Bearer CRON_SECRET)
# GOOGLE_MERCHANT_ACCOUNT_ID=
# GOOGLE_MERCHANT_DATA_SOURCE_NAME=accounts/{account_id}/dataSources/{data_source_id}
# GOOGLE_MERCHANT_DEVELOPER_EMAIL=you@reswell.app
# GOOGLE_MERCHANT_FEED_LABEL=US
# GOOGLE_MERCHANT_CONTENT_LANGUAGE=en
# GOOGLE_MERCHANT_PRODUCT_CATEGORY=499811        # surfboards (Boating & Water Sports)
# GOOGLE_MERCHANT_FINS_PRODUCT_CATEGORY=3525     # fins (Surfboard Fins); optional override
# GOOGLE_MERCHANT_MAGAZINES_PRODUCT_CATEGORY=784 # magazines (Media > Magazines); optional override
# Optional feed enrichments (brand+model → MPN + identifier_exists; extra listing photos; shipping/tax):
# GOOGLE_MERCHANT_ESTIMATED_SHIPPING_USD=89      # surfboards with Reswell-calculated shipping; default 89
# GOOGLE_MERCHANT_FINS_ESTIMATED_SHIPPING_USD=15 # fins with Reswell-calculated shipping; default 15
# GOOGLE_MERCHANT_MAGAZINES_ESTIMATED_SHIPPING_USD=10 # magazines with Reswell-calculated shipping; default 10
# GOOGLE_MERCHANT_US_TAX_RATE=0               # percentage, e.g. 8.25; omit to skip per-product tax rows
# GOOGLE_MERCHANT_SETUP_SECRET=
# GOOGLE_MERCHANT_WEBHOOK_SECRET=
# Workload Identity Federation (Vercel → GCP)
# GCP_PROJECT_ID=
# GCP_PROJECT_NUMBER=
# GCP_SERVICE_ACCOUNT_EMAIL=
# GCP_WORKLOAD_IDENTITY_POOL_ID=
# GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
# Local dev only (omit in production when using WIF):
# GOOGLE_MERCHANT_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Google Search Console — optional; powers per-page clicks/impressions/CTR in the admin SEO panel.
# Property as shown in Search Console (domain property `sc-domain:reswell.app` or URL-prefix `https://reswell.app/`).
# GOOGLE_SEARCH_CONSOLE_SITE_URL=sc-domain:reswell.app
# Auth: reuses the same Workload Identity Federation vars as Google Merchant above
# (GCP_PROJECT_NUMBER / GCP_SERVICE_ACCOUNT_EMAIL / GCP_WORKLOAD_IDENTITY_POOL_ID / GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID).
# The impersonated service account (GCP_SERVICE_ACCOUNT_EMAIL) must be added as a user with read access on the property.
# Local dev alternative — service-account JSON (falls back to GOOGLE_APPLICATION_CREDENTIALS):
# GOOGLE_SEARCH_CONSOLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Google Analytics 4 — optional; powers the on-site traffic panel on the admin Google Merchant page
# (sessions, views, engagement, and channels for product detail pages).
# Numeric GA4 property id from Admin → Property Settings.
# GA4_PROPERTY_ID=123456789
# Client-side GA4 measurement id (G-*) for partner embed page views and click events
# (/embed/listings/:slug). From Admin → Data streams → Web → Measurement ID.
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# Optional — path prefix that identifies product pages (defaults to /l/):
# GA4_PRODUCT_PATH_PREFIX=/l/
# Auth: reuses the same Workload Identity Federation vars as Google Merchant above
# (GCP_PROJECT_NUMBER / GCP_SERVICE_ACCOUNT_EMAIL / GCP_WORKLOAD_IDENTITY_POOL_ID / GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID).
# The impersonated service account (GCP_SERVICE_ACCOUNT_EMAIL) must be added as a Viewer on the GA4 property.
# Local dev alternative — service-account JSON (falls back to GOOGLE_APPLICATION_CREDENTIALS):
# GOOGLE_ANALYTICS_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Meta (Facebook) Pixel — optional; site-wide PageView + ad attribution. Numeric ID from Events Manager.
# https://developers.facebook.com/docs/meta-pixel/get-started
NEXT_PUBLIC_META_PIXEL_ID=
# Meta Conversions API (server-side events: Purchase, AddToCart) — optional but recommended; backs up the
# browser pixel against ad blockers/ITP. Browser + server events share an event_id so Meta deduplicates them.
# Generate a System User access token in Events Manager → Settings → Conversions API.
# https://developers.facebook.com/docs/marketing-api/conversions-api/get-started
# META_CONVERSIONS_API_ACCESS_TOKEN=
# META_GRAPH_API_VERSION=v21.0   # optional; defaults to v21.0
# META_TEST_EVENT_CODE=          # optional; set while verifying in Events Manager → Test Events, then remove
# Meta Commerce catalog feed for dynamic product ads: GET /api/integrations/meta/catalog-feed (CSV of active surfboard + fin listings).
# Register in Meta Commerce Manager → Catalog → Data sources → Add items → Data feed. Use the feed URL with optional secret token.
# META_CATALOG_FEED_SECRET=   # optional; require ?token= or Authorization: Bearer on catalog feed URL
# META_CATALOG_FEED_MAX_ITEMS=10000
# META_CATALOG_GOOGLE_PRODUCT_CATEGORY=499811        # surfboards (Boating & Water Sports)
# META_CATALOG_FINS_GOOGLE_PRODUCT_CATEGORY=3525     # fins (Surfboard Fins); optional override
# META_CATALOG_MAGAZINES_GOOGLE_PRODUCT_CATEGORY=784 # magazines (Media > Magazines); optional override

# Google Maps Platform — optional; US address autocomplete on /checkout (Maps JavaScript API + Places),
# optional static map image URLs (Maps Static API), and server-side
# forward/reverse geocoding + ZIP lookup on /api/geocode* when a key is set.
# Message location pins use the listing photo as the preview (no extra Maps API for that card).
# Create a browser key and restrict it by HTTP referrer (e.g. https://reswell.app/*). Enable “Maps JavaScript API”, “Places API (New)” (programmatic address autocomplete in checkout + messages), “Maps Static API” (optional), and “Geocoding API”.
# https://console.cloud.google.com/google/maps-apis
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: separate key for server routes (IP-restricted in Google Cloud; use for /api/geocode when browser key is referrer-only).
# If unset, NEXT_PUBLIC_GOOGLE_MAPS_API_KEY is used server-side (must allow Geocoding API; referrer-only keys often fail on the server).
# GOOGLE_MAPS_SERVER_API_KEY=

# Facebook Marketplace quick import — invite link for /import/listing?key=… (admins always have access).
# LISTING_IMPORT_ACCESS_KEY=

# Anthropic Claude — optional; powers “Write description for me” for surfboard listings on /sell
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Klaviyo — optional; server-side Events API (private key with Events: Write)
# Metrics: "New Account Created" (signup — Flows welcome / timed winback — see lines below), "Listing" (seller publish on /sell or POST /api/listings — Flows → Metric → Listing), "Board Alert Match" (buyer saved /boards filters with email opt-in when a new surfboard matches — profile = subscriber; props include Listing_URL, Title, Price, Brand, Model, Dimensions, Saved_Search_ID), "Board Listing Request" (buyer hit a no-results dead end on /boards or /search and asked Reswell to source the board / notify when listed — profile = requester email; props include Query, Summary, Source, Brand, Model, Dimensions; confirm + re-engage when supply lands), "Added to Cart" (buyer saves a listing; ProductID + Items for product blocks), "Checkout Started" (buyer lands on checkout — abandoned checkout trigger; checkout_items[] for dynamic blocks), "Offer Made" (buyer submits an offer; event profile = seller), "Seller Made Offer" (seller counters — proposed price; event profile = buyer), "Placed Order" (buyer completes checkout — Stripe or Reswell Bucks; ProductID + Items), "Purchase Successful" (buyer — same moment as Placed Order; shipping confirmation flow: filter `fulfillment_method = shipping`), "Local Pickup Order Placed" (buyer — pickup checkout; props include `pickup_code`, `order_url`, `order_num`, `Title`), "New Sale Received" (seller — checkout; always fires with fulfillment-specific metric below), "Shipping Sale Received" (seller — shipping checkout; structured `ship_to_*`, `label_workflow`, `label_workflow_instructions`, `sale_url`, `shipping_tools_url`), "Local Pickup Sale Received" (seller — pickup checkout; `pickup_instructions`, `sale_url`), "Shipping Label Ready" (seller — Reswell auto-label attached; `label_instructions`, `tracking_number`, `sale_url`), "Order Shipped" (buyer — seller adds tracking; once per order), "Order Shipping Update" (buyer — ShipEngine carrier scan changed; props include `status_label`, `latest_event_description`, `is_delivered`, `tracking_number`), "Sale Successful" (seller — earnings released after fulfillment; `sale_url` on `/dashboard/sales/{id}`), "Seller Reviewed Buyer" (seller submits buyer rating on an order; event profile = buyer — use for “you received a review” email), "Message Sent" (event profile = message recipient; SUPABASE_SERVICE_ROLE_KEY fills their email for Klaviyo profile + flows)
# Custom catalog feed for Klaviyo product blocks: GET /api/integrations/klaviyo/catalog-feed (JSON array of active surfboard listings). Register in Klaviyo → Content → Products → Manage Custom Catalog Sources. Then contact Klaviyo support to link ProductID on Added to Cart / Checkout Started / Placed Order to catalog $id.
# KLAVIYO_CATALOG_FEED_SECRET=   # optional; require ?token= or Authorization: Bearer on catalog feed URL
# KLAVIYO_CATALOG_FEED_MAX_ITEMS=10000
# Page views (client → POST /api/integrations/klaviyo/page-view): "Viewed Sell Page" (signed-in `/sell` only — one event/profile/day; props: Logged in, Sell page mode, Sell page URL, Needs listing nudge, listing counts), "Viewed Boards Page" (/boards…), "Viewed Site Page" (everything else; `/admin` excluded).
# Marketplace DMs fire metric **Message Sent** (profile = receiver). Event prop `message_sms_opt_in` is true when the receiver opted in via /messages; receiver phone is on the Klaviyo profile when opted in. Build a flow: trigger **Message Sent** → filter `message_sms_opt_in` = true → send **marketing** SMS (not transactional — message alerts are marketing consent).
# Sell abandonment flow (Klaviyo UI): trigger Metric **Viewed Sell Page** → filter `Needs listing nudge` = true → delay → split: has done **Listing** since flow start? → No → email with `{{ event.Sell page URL }}`; allow re-entry ~14–30d. `/sell` requires login (middleware).
# Signup fires metric **New Account Created** (email/password + Google OAuth + email confirmation). Event props include signup_method / signup_channel (google | email_password | oauth_other), account timestamps, plus profile Subscribe (marketing SUBSCRIBED). Immediate session sign-up POSTs `/api/integrations/klaviyo/new-account-created` with Bearer token; OAuth uses `/auth/callback`; confirmed email uses `/auth/confirm` or `/auth/callback` OTP.
# Inactive winback (login-based, 30-day only): daily Vercel Cron hits `GET /api/cron/klaviyo-inactivity-milestones` (Bearer `CRON_SECRET` when set). Run migrations through `20261230130000_klaviyo_inactivity_30_days_only.sql` in Supabase. Emits **User Inactive 30 Days** when `auth.users.last_sign_in_at` (or `created_at` if never signed in) is older than 30 days. Inactivity resets only on a new sign-in. Build one Klaviyo flow on that metric.
# Legacy option: Flow triggered by **New Account Created** → delay → conditional split on activity **since starting this flow** (same page-view / commerce metrics as above).
# On signup we also call Subscribe Profiles (email marketing SUBSCRIBED). For instant consent, use a single-opt-in list ID below or set single opt-in under Klaviyo → Settings → API keys (default is often double opt-in).
# Visitor newsletter popup → metric **Newsletter** (unique `promo_code`, `discount_percent`, `expires_at` / `expires_at_formatted` on the event). Build a flow: trigger Metric **Newsletter** → email with `{{ event.promo_code }}`. Codes are one-time, 10% off item price (Reswell-funded), valid 30 days; checkout validates email match.
# Optional: list ID to attach new signups (e.g. from list URL …/list/XXXX → use XXXX). List opt-in rules apply.
# KLAVIYO_EMAIL_SUBSCRIBE_LIST_ID=
# Optional: SMS list for Messages text alerts (opt-in toggle in /messages). **Required for reliable SMS** — use a single-opt-in list ID (from list URL …/list/XXXX → use XXXX). Without this, Klaviyo defaults to double opt-in and consent stays pending until the user confirms, so Message Sent SMS flows will not fire.
# KLAVIYO_SMS_SUBSCRIBE_LIST_ID=
# Debug: GET /api/integrations/klaviyo/status (returns whether the key is set, never the value)
# Manual inactive milestone (Klaviyo test): POST /api/integrations/klaviyo/trigger-inactive-milestone JSON `{"user_id":"<uuid>"}` Bearer CRON_SECRET when set; optional `"dedupe_nonce":"test-1"` for repeat sends, `"record_milestone":true` to write DB idempotency row
# Show User Inactive metrics in Flows → API (one-time): POST /api/integrations/klaviyo/bootstrap-inactive-metrics (empty body, same Bearer)
# Buyer favorites + cart (Items + dynamic product blocks; catalog ProductID = listing id): **Listing Saved** (immediate on heart — buyer profile), **Favorites Digest** (weekly cron `GET /api/cron/klaviyo-favorites-digest`, Mondays 10:00 UTC), **Favorite Price Drop** (when seller lowers list price on a published listing — fires for buyers who favorited and/or have the listing in cart; quick price edit today). Metrics appear in Klaviyo Flows → Metric → API after the first real event per name. Build **Favorite Price Drop** flow: Metric trigger → email with `{{ event.favorites_items_html }}`, `{{ event.price_drop_display }}`, optional `{{ event.checkout_url }}` when `{{ event.in_cart }}` is true.
# https://www.klaviyo.com/settings/account/api-keys
KLAVIYO_API_KEY=
# Klaviyo onsite.js (embedded forms, SMS widgets). Public company ID from Klaviyo → Account → Settings.
NEXT_PUBLIC_KLAVIYO_COMPANY_ID=RvZrDu

# Optional: base URL for listing + marketplace links inside Klaviyo (defaults to https://reswell.app if unset; ignores VERCEL_URL so preview crons don’t link to *.vercel.app)
# KLAVIYO_EMAIL_SITE_URL=https://reswell.app

# Optional: `Authorization: Bearer …` for cron routes (e.g. `GET /api/listings/purge-archived`, `GET /api/cron/klaviyo-inactivity-milestones`). If unset, those routes run without auth (dev only).
# CRON_SECRET=

# Optional: recipients for the weekly search-insights digest (`GET /api/cron/search-insights-digest`, Mondays). Comma-separated admin emails; each gets a Klaviyo "Search Insights Digest" event (build a flow off that metric). If unset, the digest cron is a no-op.
# ADMIN_DIGEST_EMAILS=ops@reswell.app,growth@reswell.app

# Vercel log monitoring — daily `GET /api/cron/vercel-error-digest` (13:00 UTC). Only VERCEL_ACCESS_TOKEN is required (PAT from vercel.com/account/tokens); project/team IDs are auto-discovered or use Vercel system vars when deployed. Each admin in ADMIN_DIGEST_EMAILS gets a Klaviyo "Platform Error Digest" event when critical/warning issues are found. Show the metric in Klaviyo Flows (one-time): `POST /api/integrations/klaviyo/bootstrap-platform-error-digest` (Bearer `CRON_SECRET` when set).
# VERCEL_ACCESS_TOKEN=
# Optional overrides (usually unnecessary on Vercel):
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=
# Local scan: `npm run env:pull` then `npm run logs:scan` (or `npm run logs:scan -- --hours 24 --json`)

# Elasticsearch (optional — powers /search when URL + auth are set)
# Elastic Cloud: project URL + API key from https://cloud.elastic.co
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
# Or self-hosted basic auth:
# ELASTICSEARCH_USERNAME=
# ELASTICSEARCH_PASSWORD=
# Local Docker with no security only:
# ELASTICSEARCH_ALLOW_ANONYMOUS=true
# Index name (default: reswell_listings)
# ELASTICSEARCH_LISTINGS_INDEX=reswell_listings
# /boards browse (filtering + "near me" geo sort + facet counts) uses Elasticsearch when the cluster
# is configured. Set to false to force the Postgres path (e.g. before reindexing with the new
# facet/geo fields). Default: enabled whenever Elasticsearch is configured.
# BOARDS_BROWSE_USE_ES=false
# Optional: override brand directory index (default reswell_brands) for /sell + nav typeahead
# ELASTICSEARCH_BRANDS_INDEX=reswell_brands
# Optional: Threads forum search index (default reswell_forum_threads)
# ELASTICSEARCH_FORUM_THREADS_INDEX=reswell_forum_threads
# Optional: search event log for admin “Search analytics” (default reswell_search_analytics)
# ELASTICSEARCH_SEARCH_ANALYTICS_INDEX=reswell_search_analytics
# Optional: typeahead click log for the same admin page (default reswell_search_suggest_analytics)
# ELASTICSEARCH_SEARCH_SUGGEST_ANALYTICS_INDEX=reswell_search_suggest_analytics

# ShipEngine — shipping labels / rates (server-only). https://www.shipengine.com/docs/auth/
# Sandbox keys start with TEST_. For local/dev, prefer TEST_ keys so purchases don’t require a funded live wallet.
# Live keys: Dashboard → billing / wallet — “Insufficient funds” on buy label means add ShipEngine balance or
# carrier billing is blocked; that is not fixed by database migrations.
# Debug: GET /api/integrations/shipengine/status
SHIPENGINE_API_KEY=
# Optional EU host: https://api.eu.shipengine.com/v1
# SHIPENGINE_API_BASE=
# Production: Dashboard → Developer → Webhooks → event `track` → POST https://<your-domain>/api/webhooks/shipengine
# (JWKS signature verification; requires SUPABASE_SERVICE_ROLE_KEY on the server)

# Shippo — rates / labels (server-only). https://docs.goshippo.com/docs/guides/getting-started/
# Debug: GET /api/integrations/shippo/status
SHIPPO_API_KEY=
# Optional override (default https://api.goshippo.com)
# SHIPPO_API_BASE=

# POST /api/search/reindex — Bearer token for CI/scripts (optional; admin UI works without it)
# SEARCH_REINDEX_SECRET=

# POST /api/search/es-webhook — Supabase Database Webhook secret header
SUPABASE_ES_WEBHOOK_SECRET=

# PayPal Payouts + Log in with PayPal (Dashboard → Apps & credentials)
# Use sandbox until PayPal approves Payouts on the business account.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live
PAYPAL_MODE=sandbox
# Same client ID as PAYPAL_CLIENT_ID — exposed to the browser for OAuth authorize URL
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Site origin for PayPal redirect_uri (must match Return URL host). Local: http://localhost:3000
NEXT_PUBLIC_URL=http://localhost:3000

# Listing photo proxy (`/media/listings/…`) — max requests/min per IP for non-browser clients (default 180 prod, 5000 dev).
# Browser `<img>` loads are exempt. Set to test throttling locally, e.g. 180.
# LISTING_MEDIA_RATE_LIMIT_MAX_REQUESTS=5000
