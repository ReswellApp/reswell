{
  "installCommand": "npm install",
  "regions": ["iad1", "sfo1"],
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=31536000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/images/home/hero-backdrop-rincon-v3.jpg",
      "headers": [
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=31536000, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/trim-recent-listing-views",
      "schedule": "30 9 * * *"
    },
    {
      "path": "/api/cron/purge-stale-offers",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/cron/shopify-sync",
      "schedule": "2-57/5 * * * *"
    },
    {
      "path": "/api/cron/sync-open-carrier-tracking",
      "schedule": "4-49/15 * * * *"
    },
    {
      "path": "/api/cron/release-carrier-delivered-payouts",
      "schedule": "5,20,35,50 * * * *"
    },
    {
      "path": "/api/cron/sync-open-return-carrier-tracking",
      "schedule": "9-54/15 * * * *"
    },
    {
      "path": "/api/cron/refund-after-return-delivered",
      "schedule": "10,25,40,55 * * * *"
    },
    {
      "path": "/api/cron/vercel-error-digest",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/link-guest-contact-messages",
      "schedule": "25 * * * *"
    },
    {
      "path": "/api/cron/sync-shipengine-adjustments",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/cron/recover-unused-shipengine-postage",
      "schedule": "15 3,15 * * *"
    },
    {
      "path": "/api/cron/support-case-backfill",
      "schedule": "14-59/15 * * * *"
    },
    {
      "path": "/api/cron/live-chat-escalate-unanswered",
      "schedule": "45 * * * *"
    }
  ]
}
