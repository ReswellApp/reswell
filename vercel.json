{
  "installCommand": "npm install",
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=31536000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/images/home/hero-backdrop-rincon-v3.jpg",
      "headers": [
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=31536000, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/klaviyo-inactivity-milestones",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/seller-message-inactivity",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/newsletter-promo-expiration-nudge",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/klaviyo-favorites-digest",
      "schedule": "0 10 * * 1"
    },
    {
      "path": "/api/cron/purge-stale-offers",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/cron/google-merchant-refresh",
      "schedule": "20 * * * *"
    },
    {
      "path": "/api/cron/elasticsearch-reindex",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/sync-open-carrier-tracking",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/release-carrier-delivered-payouts",
      "schedule": "5,20,35,50 * * * *"
    },
    {
      "path": "/api/cron/search-insights-digest",
      "schedule": "0 15 * * 1"
    },
    {
      "path": "/api/cron/backfill-listing-brand-model",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/vercel-error-digest",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/ops-ingest",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/link-guest-contact-messages",
      "schedule": "25 * * * *"
    }
  ]
}
