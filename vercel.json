{
  "installCommand": "npm install",
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=31536000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/images/home/hero-backdrop-rincon.jpg",
      "headers": [
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=31536000, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/klaviyo-inactivity-milestones",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/klaviyo-favorites-digest",
      "schedule": "0 10 * * 1"
    },
    {
      "path": "/api/cron/auto-cancel-unshipped-orders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/purge-stale-offers",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/cron/google-merchant-refresh",
      "schedule": "20 * * * *"
    },
    {
      "path": "/api/cron/release-carrier-delivered-payouts",
      "schedule": "40 * * * *"
    },
    {
      "path": "/api/cron/search-insights-digest",
      "schedule": "0 15 * * 1"
    },
    {
      "path": "/api/cron/backfill-listing-brand-model",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/vercel-error-digest",
      "schedule": "0 13 * * *"
    }
  ]
}
